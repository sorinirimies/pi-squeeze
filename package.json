{
	"name": "pi-squeeze",
	"version": "0.1.0",
	"description": "Shrinks bash output before it reaches the agent's context: native compactors for git, cargo, rg, ls, test and build output, plus rtk when installed. Full output stays one temp file away.",
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi",
		"tokens",
		"context",
		"compaction",
		"rtk"
	],
	"license": "MIT",
	"author": "Sorin Albu-Irimies",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sorinirimies/pi-squeeze.git"
	},
	"homepage": "https://github.com/sorinirimies/pi-squeeze#readme",
	"files": [
		"extensions",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./extensions/squeeze.ts"
		]
	},
	"scripts": {
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"check": "nu scripts/ci/quality_gate.nu"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*"
	},
	"overrides": {
		"undici": "8.12.3",
		"minimatch": "11.0.3"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^1.4.0",
		"@types/bun": "^1.4.4",
		"typescript": "^7.0.2"
	}
}
